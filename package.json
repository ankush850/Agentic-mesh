{
  "name": "agentic-mesh",
  "version": "1.0.0",
  "description": "Autonomous AI-powered QA Agent with locator self-healing and Jira integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentic-mesh": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/emailsink": {
      "types": "./dist/providers/emailsink.d.ts",
      "default": "./dist/providers/emailsink.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts' '*.json' '*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' '*.json' '*.ts'",
    "demo": "tsx src/demo-runner.ts",
    "agentic-mesh": "tsx src/cli.ts",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:ui": "npm --prefix web run dev",
    "jira:seed": "tsx scripts/check-jira.ts",
    "jira:seed-demo": "tsx scripts/seed-demo-tickets.ts",
    "jira:verify": "tsx scripts/verify-jira-ticket.ts",
    "demo:ticket": "tsx scripts/demo-for-ticket.ts",
    "verify:all-sqa": "tsx scripts/verify-all-sqa.ts",
    "build:ui": "npm --prefix web run build",
    "test:ui": "npm --prefix web run test",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:ui": "npm --prefix web run typecheck",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "playwright",
    "testing",
    "auto-healing",
    "ai",
    "jira",
    "agentic-mesh"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@ai-sdk/google": "^3.0.63",
    "@ai-sdk/google-vertex": "^4.0.105",
    "@ai-sdk/openai": "^3.0.52",
    "@faker-js/faker": "^10.1.0",
    "@google/genai": "^2.1.0",
    "@openrouter/ai-sdk-provider": "^2.5.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@playwright/test": "^1.51.0",
    "acorn": "^8.15.0",
    "ai": "^6.0.161",
    "axiom": "^0.46.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "groq-sdk": "^0.15.0",
    "ioredis": "^5.10.1",
    "jira.js": "^4.0.3",
    "openai": "^6.34.0",
    "parse5": "^8.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.51.0",
    "shortid": "^2.2.17",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.13.10",
    "@types/shortid": "^2.2.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
