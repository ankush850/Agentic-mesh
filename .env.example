# =============================================================================
# Agentic-mesh Core LLM Providers
# =============================================================================

# Primary LLM: Groq (ultra-fast test generation, locator repair decisions)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Secondary LLM: Google Gemini (multimodal screenshots, visual assertions, fallback)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# Jira Cloud Integration (Optional - falls back to fixtures/mock-ticket.json)
# =============================================================================
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=qa-lead@your-domain.com
JIRA_API_TOKEN=your_jira_api_token_here
# Jira project key where Bug tickets are auto-created when --auto-bug is used (e.g. SQA, QA, SCRUM).
# Find it in Jira → Projects → your project → the short code in the URL.
JIRA_PROJECT_KEY=SQA

# =============================================================================
# Redis Step Caching & Telemetry (Optional)
# =============================================================================
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Agentic-mesh Web API (server/) — used by the web console
# =============================================================================
# Port and interface for the Fastify API. The Vite dev server proxies /api here.
PORT=8787
HOST=127.0.0.1

# Serve deterministic fixtures instead of calling LLMs/Jira/Playwright.
# Required for a frontend demo with no provider keys.
# UI_MOCK=1

# Where run artifacts live (run.json, events.ndjson, repairs.jsonl, screenshots/).
# RUNS_DIR=./runs

# Comma-separated allowlist of test targets (origin, optionally with port).
# When set it REPLACES the built-in defaults, except the bundled demo app.
# ALLOWED_TARGETS=http://localhost:3000,https://www.saucedemo.com

# Launch a visible Chromium window for engine runs (debugging).
# UI_HEADED=1

# Per-IP request budget for the API.
# RATE_LIMIT_PER_MINUTE=240
